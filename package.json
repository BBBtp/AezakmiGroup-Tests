{
  "name": "@crm/e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for CRM application",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke-auth --project=smoke",
    "test:regression": "playwright test --project=regression-auth --project=regression",
    "test:auth": "playwright test tests/smoke/auth.smoke.spec.ts tests/regression/auth-ui.regression.spec.ts tests/regression/functionality.regression.spec.ts tests/regression/validation.regression.spec.ts tests/regression/session.regression.spec.ts tests/regression/access-control.regression.spec.ts --project=smoke-auth --project=regression-auth --project=regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright test && playwright show-report",
    "test:types": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "lint": "eslint .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "check:allure-ids": "node scripts/check-allure-ids.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "quality": "npm run test:types && npm run lint && npm run format:check && npm run check:allure-ids && npm run check:architecture && npm run test:unit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "mcp:doqa": "node mcp/server.mjs",
    "doqa:run": "node scripts/doqa-run.mjs",
    "doqa:summary": "node scripts/doqa-summary.mjs"
  },
  "files": [
    "components/**/*",
    "pages/**/*",
    "fixtures/**/*",
    "utils/**/*",
    "tests/**/*",
    "config/**/*",
    "playwright.config.ts",
    "tsconfig.json",
    "package.json",
    ".env.example"
  ],
  "keywords": [
    "e2e",
    "playwright",
    "testing",
    "crm"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.2",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
