# CRM environment
# Role-based access test users
E2E_ASO_ADMIN_EMAIL=
E2E_ASO_ADMIN_PASSWORD=
E2E_ASO_VIEWER_EMAIL=
E2E_ASO_VIEWER_PASSWORD=
E2E_WEB_VIEW_ADMIN_EMAIL=
E2E_WEB_VIEW_ADMIN_PASSWORD=
E2E_WEB_VIEW_VIEWER_EMAIL=
E2E_WEB_VIEW_VIEWER_PASSWORD=

E2E_BASE_URL=https://crm.example.test

# Dedicated test users
E2E_ADMIN_USERNAME=test_admin
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=replace_me
E2E_USER_USERNAME=test_user
E2E_USER_EMAIL=user@example.test
E2E_USER_PASSWORD=replace_me

# DoQA integration
DOQA_ENDPOINT=https://doqa.example.test
DOQA_SPACE_ID=123
DOQA_PROJECT_ID=
DOQA_TOKEN=replace_me
DOQA_AUTOTEST_TOKEN=replace_me
# Optional user-session authentication for internal folder operations.
# Prefer DOQA_LOGIN + DOQA_PASSWORD; DOQA_SESSION_TOKEN accepts an already issued short-lived token.
DOQA_LOGIN=
DOQA_PASSWORD=
DOQA_SESSION_TOKEN=

# Optional report settings
DOQA_RUN_TITLE=
DOQA_REPORT_DIR=reports/doqa
DOQA_VERIFY_TIMEOUT_MS=30000
BUG_DRAFTS_DIR=bug-drafts
ALLURE_RESULTS_DIR=allure-results
